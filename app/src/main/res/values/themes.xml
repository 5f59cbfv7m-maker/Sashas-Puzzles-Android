<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window only needs the page colour so no white flashes through. -->
    <style name="Theme.SashasPuzzles" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- System splash: the page colour and the mark, then Compose's own splash takes over. -->
    <style name="Theme.SashasPuzzles.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/page</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.SashasPuzzles</item>
    </style>
</resources>
